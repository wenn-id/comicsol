# Canonical artifacts are byte-stable across Windows and POSIX checkouts.
*.json text eol=lf
*.jsonl text eol=lf
*.md text eol=lf
*.py text eol=lf
*.txt text eol=lf
*.yaml text eol=lf
*.in text eol=lf
*.ps1 text eol=lf
*.sh text eol=lf
*.spec text eol=lf
*.toml text eol=lf
*.tmpl text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf

# QA report templates are documentation data, not Go source.
templates/*.tmpl linguist-documentation=true linguist-detectable=false
