# Canonical artifacts are byte-stable across Windows and POSIX checkouts.
*.json text eol=lf
*.jsonl text eol=lf
*.md text eol=lf
*.py text eol=lf
*.txt text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# QA report templates are documentation data, not Go source.
templates/*.tmpl linguist-documentation=true linguist-detectable=false
