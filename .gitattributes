# Canonical artifacts are byte-stable across Windows and POSIX checkouts.
*.json text eol=lf
*.jsonl text eol=lf
*.md text eol=lf
*.py text eol=lf
*.txt text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# QA report templates are data, not Go source; exclude them from language stats.
templates/*.tmpl linguist-detectable=false
