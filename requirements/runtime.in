# Canonical input for requirements/locks/runtime-<platform>-x86_64.txt.
# Regenerate with pip-tools==7.6.1 on the target platform (see requirements/README.md):
# python -m piptools compile --allow-unsafe --generate-hashes --strip-extras --output-file=requirements/locks/runtime-linux-x86_64.txt requirements/runtime.in
# python -m piptools compile --allow-unsafe --generate-hashes --strip-extras --output-file=requirements/locks/runtime-macos-x86_64.txt requirements/runtime.in
# python -m piptools compile --allow-unsafe --generate-hashes --strip-extras --output-file=requirements/locks/runtime-windows-x86_64.txt requirements/runtime.in
#
# Mirrors the install dependencies and the mcp extra declared in pyproject.toml,
# plus an explicitly hash-verified pip for later --require-hashes installs.
pillow==12.3.0
mcp==2.0.0
pip==26.2.1
