      "description": "Check the runtime and report a provider-neutral agent capability observation.",
      "inputSchema": {
        "properties": {
          "image_capability": {
            "anyOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "status": {
                    "enum": [
                      "available",
                      "unavailable"
                    ],
                    "type": "string"
                  },
                  "name": {
                    "anyOf": [
                      {
                        "const": "agent-image-generation",
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "supports_reference_images": {
                    "type": "boolean"
                  },
                  "supports_dimensions": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "status",
                  "name",
                  "supports_reference_images",
                  "supports_dimensions"
                ],
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Image Capability"
          }
        },
        "type": "object",
        "title": "comic_doctorArguments"
      },
      "name": "comic_doctor",
      "outputSchema": {
        "type": "object",
        "additionalProperties": true,
        "title": "comic_doctorDictOutput"
      }
    },
    {
