        "properties": {
          "title": {
            "title": "Title",
            "type": "string"
          },
          "source_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Source Text"
          },
          "request_settings": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Request Settings"
          },
          "page_count": {
            "anyOf": [
              {
                "maximum": 4,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Page Count"
          },
          "starter": {
            "anyOf": [
              {
                "enum": [
                  "minimal-one-page",
                  "dialogue-two-page",
                  "action-focused"
